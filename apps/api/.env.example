# Copy to apps/api/.env. Local placeholders only — never commit a real .env.

DATABASE_URL=postgresql://fis:fis_local_dev@localhost:5433/fis
TEST_DATABASE_URL=postgresql://fis:fis_local_dev@localhost:5433/fis_test

API_PORT=3000
WEB_ORIGIN=http://localhost:5173
API_BODY_LIMIT=32kb

# --- AI processing ------------------------------------------------------------
# none               no AI: requests go straight to manual triage (default)
# deterministic-test labelled NON-AI stand-in for demos/tests (no keys, no network)
# anthropic-voyage   real providers; needs both keys below and sends REDACTED
#                    request text to Anthropic and Voyage AI
AI_PROVIDER=none
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Verified identifiers (docs/ai-integration.md). Unverified ids are refused at startup.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-5-5
ANTHROPIC_ASSESSMENT_MODEL=claude-haiku-5-5
ANTHROPIC_EXTRACTION_EFFORT=low
ANTHROPIC_ASSESSMENT_EFFORT=medium
VOYAGE_EMBEDDING_MODEL=voyage-4-lite
PROVIDER_TIMEOUT_MS=30000

# --- Triage worker and retrieval ------------------------------------------------
TRIAGE_WORKER_ENABLED=true
TRIAGE_POLL_INTERVAL_MS=2000
TRIAGE_LEASE_MS=120000
TRIAGE_MAX_ATTEMPTS=5
RETRIEVAL_CANDIDATE_LIMIT=5
RETRIEVAL_MIN_SIMILARITY=0.25
RETRIEVAL_NEIGHBOURS=30

# --- Demo (see docs/demo.md) ----------------------------------------------------
# Dedicated demo database; must end with "_demo". Default: same server, database fis_demo.
DEMO_DATABASE_URL=postgresql://fis:fis_local_dev@localhost:5433/fis_demo
DEMO_MODE=false
