{
  "name": "feature-intelligence-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first feature-request triage: extract the underlying need, find matching need groups, and let a product manager approve every assignment.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "turbo run test:e2e --filter=@fis/web",
    "test:live": "pnpm --filter @fis/triage-core test:live",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @fis/api db:generate",
    "db:migrate": "pnpm --filter @fis/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @fis/api db:migrate:deploy",
    "dataset:generate": "pnpm --filter @fis/evaluation dataset:generate",
    "dataset:validate": "pnpm --filter @fis/evaluation dataset:validate",
    "eval": "pnpm --filter @fis/evaluation eval",
    "demo:setup": "pnpm --filter @fis/api demo:setup",
    "demo:api": "pnpm --filter @fis/api demo:api",
    "demo:seed": "pnpm --filter @fis/api demo:seed",
    "demo:reset": "pnpm --filter @fis/api demo:reset --yes"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
